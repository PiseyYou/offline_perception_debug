  // Mode 5: Multi-task recognition - 多任务识别 (分割+检测)
  ProcessResult processMode5(const Mat &left, const Mat &right, Mat grayImageL,
                             Mat grayImageR)
  {
    (void)right;
    ProcessResult result;
    result.mode_name = "MultiTask";

    cout << "[Mode 5] Multi-task recognition (seg + det)" << endl;

    // Step 1: 多任务推理
    auto infer_start = chrono::high_resolution_clock::now();
    // cv::Mat croppedImg = cv::Mat::zeros(384, 640, CV_8UC1) + 2;
    // std::vector<Detection> detections;
    // Mat left_copy = left.clone();

    cv::Rect cropRegion(0, 0, left.cols, 432);
    cv::Mat croppedImg = left(cropRegion);
    // 灰度图不再裁剪，视差图和深度图在 640x480 原始尺寸下计算

    Mat resizeImg = cv::Mat::zeros(384, 640, croppedImg.type());
    cv::resize(croppedImg, resizeImg, cv::Size(640, 384));

    cv::Mat dst_label(resizeImg.rows, resizeImg.cols, CV_8UC1);
    std::vector<Detection> detections, dect_dst, ct_dect_src;
    cv::Mat img_label = cv::Mat::zeros(384, 640, CV_8UC1) + 2;
    Mat lab_out, lab_temp;

    Rect cdt_rect;
    if (config_.enabel_cdt)
    {
      ct_dect_src.clear();
      // cdt 模型在 432 下推演，返回的是 640x432 尺度下的检测框
      cdtPerception_.perception_process_bgr(croppedImg, ct_dect_src);
      cdt_rect = get_cdt_rect(ct_dect_src);
      cout << "cdt_rect: " << cdt_rect << endl;
      cout << "cdt_rect.area: " << cdt_rect.area() << endl;
    }

    // 1. 网络在 384 下推理
    multiPerception_.perception_process_bgr_no_argmax_erode_mul(
        resizeImg, detections, img_label, config_.erode_pixel);
    filterLabelDect(img_label, detections, dst_label, dect_dst);

    // 2. 将标签图还原回 432，使用最近邻插值，防止产生浮点类别
    cv::Mat label_432;
    cv::resize(dst_label, label_432, cv::Size(640, 432), 0, 0,
               cv::INTER_NEAREST);

    // 3. 将 384 尺度下获取的检测框还原回 432
    for (auto &det : dect_dst)
    {
      det.bbox.ymin =
          std::max(0, static_cast<int>(det.bbox.ymin * (432.0f / 384.0f)));
      det.bbox.ymax =
          std::min(432, static_cast<int>(det.bbox.ymax * (432.0f / 384.0f)));
    }

    // 4. 将 cdt 遮罩施加在放大后的 label_432 上，实现坐标系严丝合缝
    if (config_.enabel_cdt && cdt_rect.area() > 0)
    {
      label_432(cdt_rect) = -1;
    }

    // printLabelDistribution(img_label);  // 直接打印分布

    auto infer_end = chrono::high_resolution_clock::now();
    cout << "[Step 1/4] Multi-task inference done: "
         << chrono::duration<double, milli>(infer_end - infer_start).count()
         << " ms" << endl;
    // cout << "  - Detections: " << detections.size() << " objects" << endl;

    // Step 2: 标签后处理 (简化版，跳过复杂的label processing)
    result.label_map = label_432.clone(); // 此后点云融合只使用 640x432 的 label
    cout << "[Step 2/4] Label processing done (simplified)" << endl;

    // Step 3: 深度计算 (视差图和深度图在 640x480 原始尺寸下计算)
    auto depth_start = chrono::high_resolution_clock::now();
    pcl::PointCloud<pcl::PointXYZRGBL> xyz_rgbl_cloud, out_xyz_rgbl_cloud;
    Mat disparity =
        stereo_multi_match.stereo_multi_process_depth(grayImageL, grayImageR);
    // 构造 640x480 的标签图，底部 48 行用背景值(2)填充，用于深度滤波
    cv::Mat label_480 = cv::Mat(480, 640, CV_8UC1, cv::Scalar(2));
    label_432.copyTo(label_480(cv::Rect(0, 0, 640, 432)));
    Mat depth_480 = stereo_multi_match.stereo_multi_process_filter(
        disparity, label_480, config_.enable_height_filter_);
    // 裁剪深度图到 640x432 (y轴 0~432)，用于后续融合
    cv::Mat depth_432 = depth_480(cv::Rect(0, 0, 640, 432)).clone();

    auto depth_end = chrono::high_resolution_clock::now();
    cout << "[Step 3/4] Depth computation done: "
         << chrono::duration<double, milli>(depth_end - depth_start).count()
         << " ms" << endl;

    // Step 4: 融合 (在 640x432 尺度下，使用裁剪后的深度图)
    auto fusion_start = chrono::high_resolution_clock::now();
    stereo_multi_match.stereo_process_pci_depth_rgb_seg_det_fusion(
        depth_432, result.label_map, dect_dst, croppedImg, xyz_rgbl_cloud,
        out_xyz_rgbl_cloud);

    if (config_.m_enable_debug_show)
    {
      Mat img_seg_show;
      // 绘制分割结果，dect_dst 已是 432 高度比例，绘制在 croppedImg(640x432) 上
      Mat pure_seg_mat =
          drawResultOptimized(croppedImg, label_432, dect_dst, img_seg_show);

      Mat origin_seg;
      cv::hconcat(croppedImg, pure_seg_mat, origin_seg); // 拼接图片1和图片2
      cv::hconcat(origin_seg, img_seg_show, origin_seg); // 拼接图片1和图片2
      Mat xyz_rgbl, final_compared;
      stereo_point_cloud stereoPointCloud;
      stereoPointCloud.show_xyz_rgbl_plane_point_cloud_final(out_xyz_rgbl_cloud,
                                                             xyz_rgbl);
      cv::vconcat(origin_seg, xyz_rgbl,
                  final_compared); // 1920x432 + 1920x960 = 1920x1392

      // 构造输出路径: finalPicDir + 原文件名 + "_cdt.jpg"
      string finalPicPath =
          config_.finalPicDir + current_image_name_ + "_mul_cdt.jpg";
      imwrite(finalPicPath, final_compared);

      string finalPcdPath =
          config_.finalPcdDir + current_image_name_ + "_mul_cdt";
      savePcdfile_with_rgb_label(out_xyz_rgbl_cloud, finalPcdPath);
    }
    auto fusion_end = chrono::high_resolution_clock::now();
    cout << "[Step 4/4] Fusion done: "
         << chrono::duration<double, milli>(fusion_end - fusion_start).count()
         << " ms" << endl;

    return result;
  }

  // Mode 6: Sub-task recognition - 子任务识别
  ProcessResult processMode6(const Mat &left, const Mat &right, Mat grayImageL,
                             Mat grayImageR)
  {
    (void)right;
    ProcessResult result;
    result.mode_name = "SubTask";

    cout << "[Mode 6] Sub-task recognition" << endl;

    // Step 1: 子任务推理
    auto infer_start = chrono::high_resolution_clock::now();

    cv::Mat croppedImg, resizeImg;
    if (left.rows == 480)
    {
      cv::Rect cropRegion(0, 0, left.cols, 432);
      croppedImg = left(cropRegion);
      resizeImg = cv::Mat::zeros(384, 640, croppedImg.type());
      cv::resize(croppedImg, resizeImg, cv::Size(640, 384));
    }
    else if (left.rows == 384)
    {
      croppedImg = left;
      resizeImg = left.clone();
    }

    // 灰度图保持原始 640x480 尺寸，用于生成 480 高度的视差图和深度图
    // 融合时再裁剪深度图到 432

    cv::Mat dst_label(resizeImg.rows, resizeImg.cols, CV_8UC1);
    std::vector<Detection> detections, dect_dst, ct_dect_src;
    cv::Mat img_label = cv::Mat::zeros(384, 640, CV_8UC1) + 2;
    Mat lab_out = cv::Mat::zeros(384, 640, CV_8UC1);
    Mat lab_temp = cv::Mat::zeros(384, 640, CV_8UC1);

    Rect cdt_rect;
    // cout << "count_stereo % frq_cdt: " << count_stereo % frq_cdt << endl;
    // if(config_.enabel_cdt && i % config_.frq_cdt == 0){
    // if(config_.enabel_cdt){
    //     ct_dect_src.clear();
    //     cdtPerception_.perception_process_bgr(croppedImg, ct_dect_src);
    //     // cout << "ct_dect_src size: " << ct_dect_src.size() << endl;
    //     cdt_rect = get_cdt_rect(ct_dect_src);
    //     // RCLCPP_INFO(this->get_logger(), "[global]===depth_time_cost:
    //     %.2f===reciev_latency: %.2f", depth_time_cost, depth_reciev_latency);
    //     cout << "cdt_rect: " << cdt_rect << endl;
    //     cout << "cdt_rect.area: " << cdt_rect.area() << endl;
    //     // RCLCPP_INFO(this->get_logger(), "cdt_rect: [x=%d, y=%d, w=%d,
    //     h=%d], area=%d",
    //     // cdt_rect.x, cdt_rect.y, cdt_rect.width, cdt_rect.height,
    //     static_cast<int>(cdt_rect.area()));
    //     // ret_cdt=1;
    // }
    // cv::Mat croppedImg = cv::Mat::zeros(384, 640, CV_8UC1) + 2;
    // cv::Mat lab_out;
    // std::vector<Detection> detections;
    // Mat left_copy = left.clone();
    // mulSubPerception.perception_process_bgr_no_argmax_erode(croppedImg,
    // detections, croppedImg, lab_out, config_.erode_pixel);
    // mulSubPerception.perception_process_bgr_no_argmax_erode(croppedImg,
    // detections, img_label, lab_out, config_.erode_pixel);
    // mulSubPerception.perception_process_bgr_no_argmax_erode(croppedImg,
    // detections, img_label, lab_out, config_.erode_pixel);
    mulSubPerception.perception_process_bgr_no_argmax_erode(
        resizeImg, detections, img_label, lab_out, config_.erode_pixel);

    // ========== DEBUG: 追踪标签变化 ==========
    cout << "\n========== 标签变化追踪 (384分辨率) ==========" << endl;

    // 统计 lab_out 中所有标签的分布
    std::map<int, int> label_dist_before;
    for (int y = 0; y < lab_out.rows; y++) {
      for (int x = 0; x < lab_out.cols; x++) {
        int label = static_cast<int>(lab_out.at<uchar>(y, x));
        label_dist_before[label]++;
      }
    }

    cout << "[A] lab_out (模型输出) 标签分布:" << endl;
    for (const auto& pair : label_dist_before) {
      if (pair.first != 2) {  // 只显示非背景标签
        cout << "    Label " << pair.first << ": " << pair.second << " pixels" << endl;
      }
    }

    filterLabelDect(lab_out, detections, dst_label, dect_dst);

    // 统计 dst_label 中所有标签的分布
    std::map<int, int> label_dist_after;
    for (int y = 0; y < dst_label.rows; y++) {
      for (int x = 0; x < dst_label.cols; x++) {
        int label = static_cast<int>(dst_label.at<uchar>(y, x));
        label_dist_after[label]++;
      }
    }

    cout << "[B] dst_label (filter后) 标签分布:" << endl;
    for (const auto& pair : label_dist_after) {
      if (pair.first != 2) {  // 只显示非背景标签
        cout << "    Label " << pair.first << ": " << pair.second << " pixels" << endl;
      }
    }

    // 如果有检测框，显示检测框信息
    cout << "[C] 检测框数量: " << detections.size() << endl;
    for (size_t i = 0; i < detections.size() && i < 5; i++) {
      cout << "    Det[" << i << "]: id=" << static_cast<int>(detections[i].id)
           << ", bbox=[" << detections[i].bbox.xmin << "," << detections[i].bbox.ymin
           << "," << detections[i].bbox.xmax << "," << detections[i].bbox.ymax << "]" << endl;
    }
    cout << "========================================\n" << endl;

    countLabelStatistics(dst_label);

    // 还原 label 至真实尺寸
    cv::Mat label_432;
    if (dst_label.rows == 384 && croppedImg.rows == 432)
    {
      cv::resize(dst_label, label_432, cv::Size(640, 432), 0, 0,
                 cv::INTER_NEAREST);
      for (auto &det : dect_dst)
      {
        det.bbox.ymin =
            std::max(0, static_cast<int>(det.bbox.ymin * (432.0f / 384.0f)));
        det.bbox.ymax =
            std::min(432, static_cast<int>(det.bbox.ymax * (432.0f / 384.0f)));
      }
    }
    else
    {
      label_432 = dst_label.clone();
    }

    // cdt_rect 在 432 或者 384 (如果不裁剪)，统一作用在 label_432 上
    if (cdt_rect.area() > 0)
    {
      label_432(cdt_rect) = -1;
    }

    // 基于 HSV 颜色对 label 进行二次修正
    // refineLabelByColor(label_432, croppedImg);

    auto infer_end = chrono::high_resolution_clock::now();
    cout << "[Step 1/3] Sub-task inference done: "
         << chrono::duration<double, milli>(infer_end - infer_start).count()
         << " ms" << endl;
    //
    result.label_map = label_432.clone();

    // 可选的点云输出
    pcl::PointCloud<pcl::PointXYZRGBL> xyz_rgbl_cloud, out_xyz_rgbl_cloud;
    Mat depth_inpainted;  // Declare at broader scope for use in debug blocks

    auto fusion_start = chrono::high_resolution_clock::now();
    if (!grayImageR.empty())
    {
      // Step 2: 深度计算 (基于 640x480 灰度图)
      auto depth_start = chrono::high_resolution_clock::now();

      Mat disparity =
          stereo_multi_match.stereo_multi_process_depth(grayImageL, grayImageR);
      // label_map 从 640x432 pad 到 640x480，底部填充 2（背景标签）
      cv::Mat label_480 = cv::Mat::zeros(480, 640, result.label_map.type()) + 2;
      result.label_map.copyTo(label_480(cv::Rect(0, 0, 640, 432)));
      // 视差图和depth都基于 640x480 生成
      Mat depth_480 = stereo_multi_match.stereo_multi_process_filter(
          disparity, label_480, config_.enable_height_filter_);
      // 裁剪 depth 到 640x432 用于融合
      cv::Rect depthCropRegion(0, 0, 640, 432);
      Mat depth_cal = depth_480(depthCropRegion);

      // ========== DEBUG: 自动查找Label 104区域 ==========
      // 从检测框中找到label=104的区域
      cv::Rect ball_roi;
      bool found_label_104 = false;

      // 遍历检测框，找到第一个label=104的区域
      for (const auto& det : dect_dst) {
        if (det.id == 4) {  // id=4对应label=104
          int xmin = std::max(0, static_cast<int>(det.bbox.xmin));
          int ymin = std::max(0, static_cast<int>(det.bbox.ymin));
          int xmax = std::min(640, static_cast<int>(det.bbox.xmax));
          int ymax = std::min(432, static_cast<int>(det.bbox.ymax));

          if (xmax > xmin && ymax > ymin) {
            ball_roi = cv::Rect(xmin, ymin, xmax - xmin, ymax - ymin);
            found_label_104 = true;
            break;
          }
        }
      }

      if (!found_label_104) {
        // 如果没有检测框，尝试从label map中查找label=104的区域
        cv::Mat mask_104;
        cv::inRange(result.label_map, cv::Scalar(104), cv::Scalar(104), mask_104);

        std::vector<std::vector<cv::Point>> contours;
        cv::findContours(mask_104, contours, cv::RETR_EXTERNAL, cv::CHAIN_APPROX_SIMPLE);

        if (!contours.empty()) {
          // 找到最大的连通区域
          int max_area = 0;
          int max_idx = 0;
          for (size_t i = 0; i < contours.size(); i++) {
            int area = cv::contourArea(contours[i]);
            if (area > max_area) {
              max_area = area;
              max_idx = i;
            }
          }

          if (max_area > 0) {
            ball_roi = cv::boundingRect(contours[max_idx]);
            found_label_104 = true;
          }
        }
      }

      if (found_label_104) {
        cout << "\n========== Label 104 区域诊断 (ROI: " << ball_roi << ") ==========" << endl;
      } else {
        cout << "\n========== 警告: 未找到Label 104区域 ==========" << endl;
        // 使用默认ROI继续诊断
        ball_roi = cv::Rect(50, 350, 80, 80);
        cout << "使用默认ROI: " << ball_roi << endl;
      }

      // Extract ball_roi dimensions
      int ball_x = ball_roi.x;
      int ball_y = ball_roi.y;
      int ball_w = ball_roi.width;
      int ball_h = ball_roi.height;

      // 1. 检查标签图中小球区域的标签值
      Mat label_roi = result.label_map(ball_roi);
      double minLabel, maxLabel;
      cv::minMaxLoc(label_roi, &minLabel, &maxLabel);
      int nonZeroLabels = cv::countNonZero(label_roi != 2); // 2是背景标签
      cout << "[1] Label map in ball region:" << endl;
      cout << "    - Label range: [" << minLabel << ", " << maxLabel << "]" << endl;
      cout << "    - Non-background pixels: " << nonZeroLabels << " / " << (ball_w * ball_h) << endl;

      // 2. 检查视差图中小球区域的视差值
      cv::Rect ball_roi_480(ball_x, ball_y, ball_w, ball_h); // 视差图是480高度，但我们检查相同xy位置
      Mat disparity_roi = disparity(ball_roi_480);
      double minDisp, maxDisp;
      cv::minMaxLoc(disparity_roi, &minDisp, &maxDisp);
      int validDispPixels = cv::countNonZero(disparity_roi > 0);
      cout << "[2] Disparity in ball region:" << endl;
      cout << "    - Disparity range: [" << minDisp << ", " << maxDisp << "]" << endl;
      cout << "    - Valid disparity pixels: " << validDispPixels << " / " << (ball_w * ball_h) << endl;

      // 3. 检查深度图中小球区域的深度值
      Mat depth_roi = depth_cal(ball_roi);
      double minDepth, maxDepth;
      cv::minMaxLoc(depth_roi, &minDepth, &maxDepth);
      int validDepthPixels = cv::countNonZero(depth_roi > 0);
      cout << "[3] Depth in ball region:" << endl;
      cout << "    - Depth range: [" << minDepth << ", " << maxDepth << "] mm" << endl;
      cout << "    - Valid depth pixels: " << validDepthPixels << " / " << (ball_w * ball_h) << endl;

      // 4. 检查深度过滤前后的差异
      Mat depth_480_roi = depth_480(ball_roi_480);
      int validDepth480Pixels = cv::countNonZero(depth_480_roi > 0);
      cout << "[4] Depth before crop (480 height):" << endl;
      cout << "    - Valid depth pixels: " << validDepth480Pixels << " / " << (ball_w * ball_h) << endl;

      // 5. 检查高度过滤器状态
      cout << "[5] Height filter enabled: " << (config_.enable_height_filter_ ? "YES" : "NO") << endl;

      // 6. 保存诊断图像
      if (config_.m_enable_debug_show)
      {
        string debugDir = config_.finalPicDir;
        // 保存小球区域的标签图
        Mat label_roi_vis;
        label_roi.convertTo(label_roi_vis, CV_8UC1, 30); // 放大显示
        cv::imwrite(debugDir + current_image_name_ + "_ball_label.jpg", label_roi_vis);

        // 保存小球区域的视差图
        Mat disp_roi_vis;
        cv::normalize(disparity_roi, disp_roi_vis, 0, 255, cv::NORM_MINMAX, CV_8UC1);
        cv::imwrite(debugDir + current_image_name_ + "_ball_disparity.jpg", disp_roi_vis);

        // 保存小球区域的深度图
        Mat depth_roi_vis;
        cv::normalize(depth_roi, depth_roi_vis, 0, 255, cv::NORM_MINMAX, CV_8UC1);
        cv::imwrite(debugDir + current_image_name_ + "_ball_depth.jpg", depth_roi_vis);

        cout << "[6] Debug images saved to: " << debugDir << endl;
      }
      cout << "========================================\n" << endl;

      auto depth_end = chrono::high_resolution_clock::now();
      cout << "[Step 2/3] Depth computation done: "
           << chrono::duration<double, milli>(depth_end - depth_start).count()
           << " ms" << endl;

      // Step 2.5: 深度补全 - 针对障碍物区域（Label >= 100）
      auto inpaint_start = chrono::high_resolution_clock::now();

      // ========== 诊断1: 检查补全前Label 104区域的深度 ==========
      cout << "\n========== 诊断1: Label 104深度补全前后对比 ==========" << endl;
      int label104_pixels = 0;
      int label104_valid_depth_before = 0;
      double label104_depth_sum_before = 0;
      for (int y = 0; y < result.label_map.rows; y++) {
        for (int x = 0; x < result.label_map.cols; x++) {
          if (result.label_map.at<uchar>(y, x) == 104) {
            label104_pixels++;
            float d = depth_cal.at<float>(y, x);
            if (d > 0 && d < 6.0f) {
              label104_valid_depth_before++;
              label104_depth_sum_before += d;
            }
          }
        }
      }
      cout << "Label 104 像素总数: " << label104_pixels << endl;
      cout << "补全前有效深度像素: " << label104_valid_depth_before
           << " (" << (label104_pixels > 0 ? 100.0 * label104_valid_depth_before / label104_pixels : 0) << "%)" << endl;
      if (label104_valid_depth_before > 0) {
        cout << "补全前平均深度: " << (label104_depth_sum_before / label104_valid_depth_before) << " m" << endl;
      }

      // 先基于检测框进行深度补全
      Mat depth_after_det = depthInpaintingByDetections(depth_cal, result.label_map, dect_dst);

      // 再进行全局障碍物区域补全
      depth_inpainted = depthInpaintingForObstacles(depth_after_det, result.label_map);

      // 检查补全后的深度
      int label104_valid_depth_after = 0;
      double label104_depth_sum_after = 0;
      for (int y = 0; y < result.label_map.rows; y++) {
        for (int x = 0; x < result.label_map.cols; x++) {
          if (result.label_map.at<uchar>(y, x) == 104) {
            float d = depth_inpainted.at<float>(y, x);
            if (d > 0 && d < 6.0f) {
              label104_valid_depth_after++;
              label104_depth_sum_after += d;
            }
          }
        }
      }
      cout << "补全后有效深度像素: " << label104_valid_depth_after
           << " (" << (label104_pixels > 0 ? 100.0 * label104_valid_depth_after / label104_pixels : 0) << "%)" << endl;
      if (label104_valid_depth_after > 0) {
        cout << "补全后平均深度: " << (label104_depth_sum_after / label104_valid_depth_after) << " m" << endl;
      }
      cout << "深度补全增加: " << (label104_valid_depth_after - label104_valid_depth_before) << " 像素" << endl;
      cout << "========================================\n" << endl;

      auto inpaint_end = chrono::high_resolution_clock::now();
      cout << "[Step 2.5/3] Depth inpainting done: "
           << chrono::duration<double, milli>(inpaint_end - inpaint_start).count()
           << " ms" << endl;

      // Step 3: 融合 (所有元件统一 640x432)
      cout << "\n========== 融合过程诊断 ==========" << endl;
      cout << "[Before fusion] xyz_rgbl_cloud size: " << xyz_rgbl_cloud.size() << endl;

      stereo_multi_match.stereo_process_pci_depth_rgb_seg_det_fusion(
          depth_inpainted, result.label_map, dect_dst, croppedImg, xyz_rgbl_cloud,
          out_xyz_rgbl_cloud);

      cout << "[After fusion] xyz_rgbl_cloud size: " << xyz_rgbl_cloud.size() << endl;
      cout << "[After fusion] out_xyz_rgbl_cloud size: " << out_xyz_rgbl_cloud.size() << endl;

      // 统计点云中各标签的数量
      std::map<uint32_t, int> pc_label_dist;
      for (const auto& pt : xyz_rgbl_cloud.points) {
        pc_label_dist[pt.label]++;
      }
      cout << "[Point cloud] Label distribution before filter:" << endl;
      for (const auto& pair : pc_label_dist) {
        if (pair.first != 1 && pair.first != 2) {  // 不显示草地和背景
          cout << "    Label " << pair.first << ": " << pair.second << " points" << endl;
        }
      }

      // 统计Label 104在融合前后的数量变化
      int label104_before = pc_label_dist[104];
      int label104_after = 0;

      std::map<uint32_t, int> out_pc_label_dist;
      for (const auto& pt : out_xyz_rgbl_cloud.points) {
        out_pc_label_dist[pt.label]++;
        if (pt.label == 104) {
          label104_after++;
        }
      }
      cout << "[Point cloud] Label distribution after filter:" << endl;
      for (const auto& pair : out_pc_label_dist) {
        if (pair.first != 1 && pair.first != 2) {
          cout << "    Label " << pair.first << ": " << pair.second << " points" << endl;
        }
      }

      if (label104_before > 0) {
        int label104_filtered = label104_before - label104_after;
        cout << "\n[Label 104 过滤统计]" << endl;
        cout << "  融合前: " << label104_before << " points" << endl;
        cout << "  融合后: " << label104_after << " points" << endl;
        cout << "  被过滤: " << label104_filtered << " points ("
             << (100.0 * label104_filtered / label104_before) << "%)" << endl;
      }
      cout << "========================================\n" << endl;
    };

    if (config_.m_enable_debug_show)
    {
      Mat img_seg_show;
      // Mat pure_seg_mat = drawResult(croppedImg, dst_label, dect_dst,
      // img_seg_show); Mat pure_seg_mat = drawResult(resizeImg, dst_label,
      // dect_dst, img_seg_show);
      Mat pure_seg_mat = drawResultOptimized(croppedImg, result.label_map,
                                             dect_dst, img_seg_show);
      Mat origin_seg;

      cv::hconcat(croppedImg, pure_seg_mat, origin_seg); // 拼接图片1和图片2
      cv::hconcat(origin_seg, img_seg_show, origin_seg); // 拼接图片1和图片2
      Mat xyz_rgbl, final_compared;
      stereo_point_cloud stereoPointCloud;
      if (!grayImageR.empty())
      {
        // ========== DEBUG: 分别统计两个检测框的点云 ==========
        cout << "\n========== 两个检测框的点云分布 ==========" << endl;
        if (dect_dst.size() >= 2) {
          // 第一个检测框
          cv::Rect det0_rect(
            std::max(0, static_cast<int>(dect_dst[0].bbox.xmin)),
            std::max(0, static_cast<int>(dect_dst[0].bbox.ymin)),
            std::min(640, static_cast<int>(dect_dst[0].bbox.xmax)) - std::max(0, static_cast<int>(dect_dst[0].bbox.xmin)),
            std::min(432, static_cast<int>(dect_dst[0].bbox.ymax)) - std::max(0, static_cast<int>(dect_dst[0].bbox.ymin))
          );

          // 第二个检测框
          cv::Rect det1_rect(
            std::max(0, static_cast<int>(dect_dst[1].bbox.xmin)),
            std::max(0, static_cast<int>(dect_dst[1].bbox.ymin)),
            std::min(640, static_cast<int>(dect_dst[1].bbox.xmax)) - std::max(0, static_cast<int>(dect_dst[1].bbox.xmin)),
            std::min(432, static_cast<int>(dect_dst[1].bbox.ymax)) - std::max(0, static_cast<int>(dect_dst[1].bbox.ymin))
          );

          cout << "检测框0: " << det0_rect << endl;
          cout << "检测框1: " << det1_rect << endl;

          // 统计label map中两个检测框内的label=104像素数
          int det0_label104_pixels = 0;
          int det1_label104_pixels = 0;

          for (int y = det0_rect.y; y < det0_rect.y + det0_rect.height; y++) {
            for (int x = det0_rect.x; x < det0_rect.x + det0_rect.width; x++) {
              if (result.label_map.at<uchar>(y, x) == 104) {
                det0_label104_pixels++;
              }
            }
          }

          for (int y = det1_rect.y; y < det1_rect.y + det1_rect.height; y++) {
            for (int x = det1_rect.x; x < det1_rect.x + det1_rect.width; x++) {
              if (result.label_map.at<uchar>(y, x) == 104) {
                det1_label104_pixels++;
              }
            }
          }

          cout << "检测框0内Label 104像素数: " << det0_label104_pixels << endl;
          cout << "检测框1内Label 104像素数: " << det1_label104_pixels << endl;

          // 检查检测框1的深度情况
          Mat depth_det1_roi = depth_inpainted(det1_rect);
          int valid_depth_det1 = cv::countNonZero(depth_det1_roi > 0);
          double min_depth_det1, max_depth_det1;
          cv::minMaxLoc(depth_det1_roi, &min_depth_det1, &max_depth_det1);

          cout << "\n[检测框1深度诊断]" << endl;
          cout << "  - 有效深度像素: " << valid_depth_det1 << " / " << (det1_rect.width * det1_rect.height) << endl;
          cout << "  - 深度范围: [" << min_depth_det1 << ", " << max_depth_det1 << "] mm" << endl;
        }
        cout << "========================================\n" << endl;

        // ========== DEBUG: 检查Label 104点的坐标范围 ==========
        float min_x = 1e6, max_x = -1e6;
        float min_y = 1e6, max_y = -1e6;
        float min_z = 1e6, max_z = -1e6;
        int label104_count = 0;
        int label104_y_filtered = 0;  // 统计被Y轴过滤的点数

        // 先检查融合前的点云（过滤前）
        for (const auto& pt : xyz_rgbl_cloud.points) {
          if (pt.label == 104) {
            label104_count++;
            min_x = std::min(min_x, pt.x);
            max_x = std::max(max_x, pt.x);
            min_y = std::min(min_y, pt.y);
            max_y = std::max(max_y, pt.y);
            min_z = std::min(min_z, pt.z);
            max_z = std::max(max_z, pt.z);

            // 检查是否会被Y轴过滤器过滤掉
            if (pt.y < -3.0 || pt.y > 0.5) {
              label104_y_filtered++;
            }
          }
        }

        cout << "\n========== 诊断4: Label 104 点云Y轴过滤诊断 ==========" << endl;
        if (label104_count > 0) {
          cout << "融合后Label 104点数（过滤前）: " << label104_count << endl;
          cout << "X range: [" << min_x << ", " << max_x << "]" << endl;
          cout << "Y range: [" << min_y << ", " << max_y << "]" << endl;
          cout << "Z range: [" << min_z << ", " << max_z << "]" << endl;
          cout << "\n[Y轴过滤器分析]" << endl;
          cout << "  过滤器范围: Y ∈ [-3.0, 0.5]" << endl;
          cout << "  会被过滤的点数: " << label104_y_filtered << " / " << label104_count
               << " (" << (100.0 * label104_y_filtered / label104_count) << "%)" << endl;
          if (label104_y_filtered == label104_count) {
            cout << "  ⚠️  警告: 所有Label 104点的Y坐标都超出过滤范围！" << endl;
          } else if (label104_y_filtered > label104_count * 0.5) {
            cout << "  ⚠️  警告: 超过50%的Label 104点会被Y轴过滤器移除！" << endl;
          }
        } else {
          cout << "⚠️  警告: 融合后没有生成任何Label 104点云！" << endl;
        }
        cout << "========================================\n" << endl;

        // 原有的检查过滤后的点云
        float min_x_out = 1e6, max_x_out = -1e6;
        float min_y_out = 1e6, max_y_out = -1e6;
        float min_z_out = 1e6, max_z_out = -1e6;
        int label104_count_out = 0;

        for (const auto& pt : out_xyz_rgbl_cloud.points) {
          if (pt.label == 104) {
            label104_count_out++;
            min_x_out = std::min(min_x_out, pt.x);
            max_x_out = std::max(max_x_out, pt.x);
            min_y_out = std::min(min_y_out, pt.y);
            max_y_out = std::max(max_y_out, pt.y);
            min_z_out = std::min(min_z_out, pt.z);
            max_z_out = std::max(max_z_out, pt.z);
          }
        }

        if (label104_count_out > 0) {
          cout << "\n========== Label 104 点云坐标范围（过滤后）==========" << endl;
          cout << "Label 104 点数: " << label104_count_out << endl;
          cout << "X range: [" << min_x_out << ", " << max_x_out << "]" << endl;
          cout << "Y range: [" << min_y_out << ", " << max_y_out << "]" << endl;
          cout << "Z range: [" << min_z_out << ", " << max_z_out << "]" << endl;
          cout << "========================================\n" << endl;
        } else {
          cout << "\n⚠️  警告: 过滤后没有Label 104点云！" << endl;
          if (label104_count > 0) {
            cout << "原因分析: 融合生成了 " << label104_count << " 个点，但全部被过滤器移除" << endl;
          }
          cout << "========================================\n" << endl;
        }

        // 检查整个点云的范围
        pcl::PointXYZRGBL p_min, p_max;
        pcl::getMinMax3D(out_xyz_rgbl_cloud, p_min, p_max);
        cout << "\n========== 整个点云坐标范围 ==========" << endl;
        cout << "Total points: " << out_xyz_rgbl_cloud.size() << endl;
        cout << "X range: [" << p_min.x << ", " << p_max.x << "]" << endl;
        cout << "Y range: [" << p_min.y << ", " << p_max.y << "]" << endl;
        cout << "Z range: [" << p_min.z << ", " << p_max.z << "]" << endl;
        cout << "========================================\n" << endl;

        stereoPointCloud.show_xyz_rgbl_plane_point_cloud_final(
            out_xyz_rgbl_cloud, xyz_rgbl);
        cv::vconcat(origin_seg, xyz_rgbl,
                    final_compared); // 再将图片3拼接到结果中
        string finalPcdPath =
            config_.finalPcdDir + current_image_name_ + "_sub_cdt";
        savePcdfile_with_rgb_label(out_xyz_rgbl_cloud, finalPcdPath);
      }
      else
      {
        final_compared = origin_seg;
      }

      // 构造输出路径: finalPicDir + 原文件名 + "_cdt.jpg"
      string finalPicPath =
          config_.finalPicDir + current_image_name_ + "_sub_cdt.jpg";
      imwrite(finalPicPath, final_compared);
    }
    auto fusion_end = chrono::high_resolution_clock::now();
    cout << "[Step 3/3] Fusion done: "
         << chrono::duration<double, milli>(fusion_end - fusion_start).count()
         << " ms" << endl;

    // 保存点云到结果
    result.point_cloud = out_xyz_rgbl_cloud;

    return result;
  }
};

// 主程序
int main(int argc, char **argv)
{
  (void)argc; (void)argv;
  cout << "==================================================" << endl;
  cout << "  Offline Perception Debug Tool (Mode-Based)    " << endl;
  cout << "==================================================" << endl;

  // 读取配置
  OfflinePerceptionProcessor::Config config;
  // TODO: 从config.yaml读取配置（目前固定为 mode 6：Sub-task）
  config.infer_mode = 6;
  bool ret_pcd_dir = false;

  // 默认路径
  // string input_dir = "/home/youfeng/debug/03/03/userdata/rosbag_record/rosbag_LK-MR6P1US000107_camera_202603031104/stereo_output_rosbag_LK-MR6P1US000107_camera_202603031104_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/03/userdata/rosbag_record/rosbag_LK-MR6P1US000107_camera_202603031122/stereo_output_rosbag_LK-MR6P1US000107_camera_202603031122_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/03/userdata/rosbag_record/rosbag_LK-MR6P1US000107_camera_202603030959/stereo_output_rosbag_LK-MR6P1US000107_camera_202603030959_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/03/avoiding_people/rosbag_LK-MR6P1US000107_camera_202603031816/stereo_output_rosbag_LK-MR6P1US000107_camera_202603031816_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/04/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603041117/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603041117_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/04/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603041117/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603041117_0/images/extracted_interval/debug/";
  // string input_dir = "/home/youfeng/debug/03/04/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603041117/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603041117_0/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/04/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603041117/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603041117_0/images/extracted_interval/bottle/";
  // string input_dir = "/home/youfeng/debug/03/05/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603051439/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603051439_0_filtered_20260305_1439_to_20260305_1441/images/error/";
  // string input_dir = "/home/youfeng/debug/03/06/bug/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603061618/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603061618_0_filtered_20260306_1619_to_20260306_1621/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/06/bug/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603061439/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603061439_0_filtered_20260306_1441_to_20260306_1443/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/06/bug/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603061551/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603061551_0_filtered_20260306_1552_to_20260306_1554/images/extracted_interval/";
  // string input_dir = "/home/youfeng/debug/03/06/bug/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603061404/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603061404_0_filtered_20260306_1405_to_20260306_1408/images/no_point/";
  string input_dir = "/home/youfeng/debug/03/06/bug/userdata/rosbag_record/rosbag_LK-MR6P1US000107_navigation_202603061404/stereo_output_rosbag_LK-MR6P1US000107_navigation_202603061404_0_filtered_20260306_1405_to_20260306_1408/images/no_point/";
  cout << "\nInput directory: " << input_dir << endl;

  // 构造最终结果输出目录
  const string mode_suffix =
      to_string(config.infer_mode) + "_" + to_string(config.erode_pixel);
  if (config.infer_mode == 5)
  {
    config.finalPicDir = input_dir + "/cdt_mul_" + mode_suffix + "_0303_update_432/";
  }
  else if (config.infer_mode == 6)
  {
    config.finalPicDir = input_dir + "/cdt_sub_" + mode_suffix + "_0304_det_0.2_pc_432/";
  }
  config.finalPcdDir =
      input_dir + "/pcd_" + mode_suffix + "_0304_432/"; // 设置最终PCD输出目录

  fs::create_directories(config.finalPicDir);
  if (ret_pcd_dir)
  {
    fs::create_directories(config.finalPcdDir);
  }

  cout << "\n========== Configuration ==========" << endl;
  cout << "Inference mode: " << config.infer_mode << endl;
  cout << "Erode pixel: " << config.erode_pixel << endl;
  cout << "Area threshold: " << config.area_threshold << endl;
  cout << "Detection threshold: " << config.detection_threshold << endl;
  cout << "===================================" << endl;

  // 初始化处理器
  OfflinePerceptionProcessor processor(config);
  if (!processor.init())
  {
    cerr << "\n[Error] Failed to initialize perception processor" << endl;
    return -1;
  }

  // 扫描输入文件
  vector<string> image_files;
  try
  {
    for (const auto &entry : fs::directory_iterator(input_dir))
    {
      if (!entry.is_regular_file())
        continue;

      string filename = entry.path().filename().string();
      string ext = entry.path().extension().string();

      // 支持常见图像格式
      if (ext == ".jpg" || ext == ".jpeg" || ext == ".png" || ext == ".bmp")
      {
        image_files.push_back(entry.path().string());
      }
    }
  }
  catch (const fs::filesystem_error &e)
  {
    cerr << "[Error] Cannot access input directory: " << e.what() << endl;
    return -1;
  }

  if (image_files.empty())
  {
    cout << "\n[Warning] No image files found in input directory." << endl;
    cout << "Supported formats: .jpg, .jpeg, .png, .bmp" << endl;
    return 0;
  }

  // 按文件名排序
  sort(image_files.begin(), image_files.end());

  cout << "\nFound " << image_files.size() << " image file(s)." << endl;

  // 处理每一张图像
  for (size_t i = 0; i < image_files.size(); i++)
  {
    const string &image_path = image_files[i];

    Mat full_img = imread(image_path);
    if (full_img.cols == 1280)
    {
      ret_pcd_dir = true;
    }

    if (full_img.empty())
    {
      cerr << "[Error] Cannot read image: " << image_path << endl;
      continue;
    }

    // 从完整图像中提取左右区域：
    // - 若为典型双目格式（宽度是高度的两倍，如
    // 1280x480），按水平中线切成左右两幅
    // - 否则认为是单目图像，只使用整幅作为 left_img
    int width = full_img.cols;
    int height = full_img.rows;
    int half_width = width / 2;

    Mat left_img = full_img.clone(); // 默认整幅作为左图
    Mat right_img;                   // 默认没有右图

    // 典型双目格式：左右拼接
    if (width == 1280 && height == 480)
    {
      left_img = full_img(Rect(0, 0, half_width, height)).clone();
      right_img = full_img(Rect(half_width, 0, half_width, height)).clone();
    }

    if (left_img.empty())
    {
      cerr << "[Error] Left image is empty after splitting: " << image_path
           << endl;
      continue;
    }

    cout << "\n[Image " << (i + 1) << "/" << image_files.size() << "] "
         << fs::path(image_path).filename().string() << endl;
    cout << "Full image size: " << full_img.size()
         << " -> Left/Right: " << left_img.size() << endl;

    // 获取原文件名（不含扩展名）
    string base_name = fs::path(image_path).stem().string();

    // 执行感知处理
    auto result = processor.process(left_img, right_img, i, base_name);
    //
    // // 生成输出文件名
    // string output_prefix = (fs::path(output_dir) / base_name).string();
    //
    // // 保存结果
    // if (!result.point_cloud.empty()) {
    //     // 保存PCD文件
    //     pcl::io::savePCDFileASCII(output_prefix + ".pcd",
    //     result.point_cloud); cout << "[Saved] " << output_prefix << ".pcd" <<
    //     endl;
    //
    //     // 保存三视图
    //     PointCloudVisualizer::saveThreeViews(result.point_cloud,
    //     output_prefix);
    //
    //     // 保存标签分布统计
    //     PointCloudVisualizer::saveLabelDistribution(result.point_cloud);
    // }
    //
    // // 保存深度图
    // if (!result.depth_map.empty()) {
    //     Mat depth_vis;
    //     normalize(result.depth_map, depth_vis, 0, 255, NORM_MINMAX, CV_8U);
    //     applyColorMap(depth_vis, depth_vis, COLORMAP_JET);
    //     imwrite(output_prefix + "_depth.jpg", depth_vis);
    //     cout << "[Saved] " << output_prefix << "_depth.jpg" << endl;
    // }
    //
    // // 保存标签图
    // if (!result.label_map.empty()) {
    //     Mat label_vis = result.label_map * 20;  // 放大显示
    //     imwrite(output_prefix + "_labels.png", label_vis);
    //     cout << "[Saved] " << output_prefix << "_labels.png" << endl;
    // }

    cout << "[Progress] " << (i + 1) << "/" << image_files.size()
         << " completed.\n"
         << endl;
  }

  cout << "\n==================================================" << endl;
  cout << "  All processing completed!                      " << endl;
  cout << "  Check output directory: " << config.finalPicDir << endl;
  cout << "==================================================" << endl;

  return 0;
}
